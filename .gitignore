# vscode

.settings/
bin/
.classpath
.project

# Keep the run configs under version control -- `gradlew vscode` overwrites
# launch.json with configs that cannot work for a Kotlin mod, so losing these
# is a real risk. settings.json stays ignored: it holds machine-specific paths.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# macos

*.DS_Store

# fabric

run/

# Generated data is committed, but its hash cache churns on every datagen run.
src/main/generated/.cache/

# java

hs_err_*.log
replay_*.log
*.hprof
*.jfr

# Python bytecode from the generators in tools/
__pycache__/
*.pyc

# Scratch space for working an idea out before it becomes a real addition --
# sprite drafts, mechanics written up in prose, throwaway generators. Untracked
# on purpose: the point is to be free to be wrong in here, and a half-finished
# design in the history reads like a decision that was made. What survives moves
# out to tools/, src/ or resources/ and is committed there.
concept/
