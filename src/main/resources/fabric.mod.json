{
	"schemaVersion": 1,
	"id": "vanguard-spirits",
	"version": "${version}",
	"name": "Vanguard Spirits",
	"description": "Under the deepslate lie ruins that were never abandoned. Something still keeps them. Bring back what you can carry, and find out how much that is.",
	"authors": [
		"Fresh-glitch"
	],
	"contact": {
		"homepage": "https://github.com/Fresh-glitch/vanguard-spirits",
		"sources": "https://github.com/Fresh-glitch/vanguard-spirits",
		"issues": "https://github.com/Fresh-glitch/vanguard-spirits/issues"
	},
	"license": "MIT",
	"icon": "assets/vanguard-spirits/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "io.github.freshglitch.vanguardspirits.VanguardSpirits",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "io.github.freshglitch.vanguardspirits.client.VanguardSpiritsClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "io.github.freshglitch.vanguardspirits.client.VanguardSpiritsDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"vanguard-spirits.mixins.json",
		{
			"config": "vanguard-spirits.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}