{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Gradle: runClient",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["runClient"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "Gradle: runServer",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["runServer"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "Gradle: runDatagen",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["runDatagen"],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "Gradle: build",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["build"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },

        // Background variants used by the "Debug ..." launch configs. Each starts
        // the game with the JVM suspended on port 5005 and reports "ready" as soon
        // as it prints the listening banner, at which point VS Code attaches.
        {
            "label": "Gradle: runClient (suspended on 5005)",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["runClient", "--debug-jvm"],
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": {
                "pattern": [
                    { "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Starting Gradle Daemon.*|^.*Configure project.*$",
                    "endsPattern": "Listening for transport dt_socket at address"
                }
            }
        },
        {
            "label": "Gradle: runServer (suspended on 5005)",
            "type": "shell",
            "command": "${workspaceFolder}/gradlew.bat",
            "args": ["runServer", "--debug-jvm"],
            "options": { "cwd": "${workspaceFolder}" },
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": {
                "pattern": [
                    { "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Starting Gradle Daemon.*|^.*Configure project.*$",
                    "endsPattern": "Listening for transport dt_socket at address"
                }
            }
        }
    ]
}
